{
    "uid": "behemoth-production",
    "title": "Behemoth Production",
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-24h",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "API Requests / 5m",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "sum(rate(behemoth_http_requests_total[5m]))",
                    "legendFormat": "req/s"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "decimals": 2
                }
            }
        },
        {
            "id": 2,
            "type": "stat",
            "title": "p95 Latency (5m)",
            "gridPos": {
                "x": 6,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(behemoth_http_request_duration_seconds_bucket[5m])) by (le))",
                    "legendFormat": "p95"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "decimals": 3
                }
            }
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Active Positions",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "sum(behemoth_positions_active_total{strategy_id=\"mom_m15\"})",
                    "legendFormat": "active"
                }
            ]
        },
        {
            "id": 4,
            "type": "stat",
            "title": "Guardrail Paused Pairs",
            "gridPos": {
                "x": 18,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "sum(behemoth_guardrail_paused_total{strategy_id=\"mom_m15\"})",
                    "legendFormat": "paused"
                }
            ]
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Account Equity",
            "gridPos": {
                "x": 0,
                "y": 4,
                "w": 12,
                "h": 6
            },
            "targets": [
                {
                    "expr": "behemoth_account_equity{strategy_id=\"mom_m15\"}",
                    "legendFormat": "{{strategy_id}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "currencyUSD",
                    "decimals": 2
                }
            }
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Account Peak Equity",
            "gridPos": {
                "x": 12,
                "y": 4,
                "w": 12,
                "h": 6
            },
            "targets": [
                {
                    "expr": "behemoth_account_peak_equity{strategy_id=\"mom_m15\"}",
                    "legendFormat": "{{strategy_id}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "currencyUSD",
                    "decimals": 2
                }
            }
        },
        {
            "id": 7,
            "type": "stat",
            "title": "Account Halted",
            "gridPos": {
                "x": 0,
                "y": 10,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "max(behemoth_account_halted{strategy_id=\"mom_m15\"})",
                    "legendFormat": "halted"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "OK"
                                },
                                "1": {
                                    "text": "HALTED"
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": 15,
            "type": "stat",
            "title": "Mean Return / Trade (%)",
            "gridPos": {
                "x": 12,
                "y": 10,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "behemoth_closed_trades_mean_bps{strategy_id=\"mom_m15\"} / 100",
                    "legendFormat": "mean_return_/_trade_(%)"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "decimals": 2
                }
            }
        },
        {
            "id": 17,
            "type": "stat",
            "title": "Closed Trades",
            "gridPos": {
                "x": 18,
                "y": 10,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "behemoth_closed_trades_total{strategy_id=\"mom_m15\"}",
                    "legendFormat": "closed_trades"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "decimals": 0
                }
            }
        },
        {
            "id": 18,
            "type": "stat",
            "title": "Daily Drawdown (%)",
            "gridPos": {
                "x": 12,
                "y": 14,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "(behemoth_account_equity{strategy_id=\"mom_m15\"} - behemoth_account_day_start_equity{strategy_id=\"mom_m15\"}) / behemoth_account_day_start_equity{strategy_id=\"mom_m15\"} * 100",
                    "legendFormat": "daily_drawdown_(%)"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "decimals": 2
                }
            }
        },
        {
            "id": 19,
            "type": "stat",
            "title": "Drawdown vs Peak (%)",
            "gridPos": {
                "x": 18,
                "y": 14,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "(behemoth_account_equity{strategy_id=\"mom_m15\"} - behemoth_account_peak_equity{strategy_id=\"mom_m15\"}) / behemoth_account_peak_equity{strategy_id=\"mom_m15\"} * 100",
                    "legendFormat": "drawdown_vs_peak_(%)"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "decimals": 2
                }
            }
        },
        {
            "id": 16,
            "type": "stat",
            "title": "Paused Pairs (Count)",
            "gridPos": {
                "x": 6,
                "y": 10,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "behemoth_guardrail_paused_total{strategy_id=\"mom_m15\"}",
                    "legendFormat": "paused_pairs"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "decimals": 0
                }
            }
        },
        {
            "id": 9,
            "type": "table",
            "title": "Active Positions by Pair",
            "gridPos": {
                "x": 12,
                "y": 18,
                "w": 12,
                "h": 6
            },
            "targets": [
                {
                    "expr": "sum by (pair) (behemoth_positions_active_by_pair{strategy_id=\"mom_m15\"})",
                    "legendFormat": "{{pair}}",
                    "format": "table",
                    "instant": true
                }
            ],
            "transformations": [
                {
                    "id": "labelsToFields"
                },
                {
                    "id": "organize",
                    "options": {
                        "renameByName": {
                            "Value": "count"
                        },
                        "excludeByName": {
                            "__name__": true,
                            "instance": true,
                            "job": true,
                            "strategy_id": true,
                            "Time": true
                        }
                    }
                }
            ],
            "options": {
                "showHeader": true,
                "cellHeight": "sm"
            }
        },
        {
            "id": 10,
            "type": "table",
            "title": "Guardrail Paused Pairs",
            "gridPos": {
                "x": 0,
                "y": 24,
                "w": 24,
                "h": 6
            },
            "targets": [
                {
                    "expr": "behemoth_guardrail_cooldown_seconds{strategy_id=\"mom_m15\"}",
                    "legendFormat": "{{strategy_id}} {{pair}}"
                }
            ],
            "transformations": [
                {
                    "id": "labelsToFields"
                },
                {
                    "id": "organize",
                    "options": {
                        "renameByName": {
                            "Value": "cooldown_s"
                        }
                    }
                }
            ]
        },
        {
            "id": 14,
            "type": "timeseries",
            "title": "Active Positions History",
            "gridPos": {
                "x": 0,
                "y": 30,
                "w": 24,
                "h": 6
            },
            "targets": [
                {
                    "expr": "behemoth_positions_active_total{strategy_id=\"mom_m15\"}",
                    "legendFormat": "{{strategy_id}}"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        }
    ],
    "templating": {
        "list": []
    }
}